{
  "$schema": "./tokens.schema.json",
  "version": 1,
  "source": {
    "brand": "sandrogekeler/kapitel-kapital-wiki",
    "file": "src/styles/tokens.css",
    "seeded": "2026-09-28",
    "note": "The neutrals, hairlines, fonts, radii and motion are the wiki's own values. fg-soft and the chapter accents come from docs/HANDOFF.md and the design reference; see docs/adr/0008-design-tokens.md for why the wiki is not the file this app builds from yet."
  },
  "color": {
    "surface": {
      "bg-sunken": {
        "dark": { "hex": "#08080a" },
        "light": { "hex": "#e9e9ec" }
      },
      "bg": { "dark": { "hex": "#0c0c0e" }, "light": { "hex": "#f7f7f8" } },
      "bg-raised": {
        "dark": { "hex": "#131316" },
        "light": { "hex": "#ffffff" }
      },
      "bg-raised-2": {
        "dark": { "hex": "#1a1a1f" },
        "light": { "hex": "#fcfcfd" }
      },
      "bg-hover": {
        "dark": { "hex": "#212127" },
        "light": { "hex": "#eeeef1" }
      }
    },
    "text": {
      "fg": { "dark": { "hex": "#ededf0" }, "light": { "hex": "#14141a" } },
      "fg-soft": {
        "dark": { "hex": "#c8c8cf" },
        "light": { "hex": "#2e2e38" }
      },
      "fg-muted": {
        "dark": { "hex": "#a5a5ae" },
        "light": { "hex": "#4c4c58" }
      },
      "fg-faint": {
        "dark": { "hex": "#8c8c97" },
        "light": { "hex": "#63636f" }
      }
    },
    "line": {
      "line": {
        "dark": { "hex": "#ffffff", "alpha": 0.09 },
        "light": { "hex": "#000000", "alpha": 0.11 }
      },
      "line-strong": {
        "dark": { "hex": "#ffffff", "alpha": 0.17 },
        "light": { "hex": "#000000", "alpha": 0.2 }
      }
    },
    "chapter": {
      "luxemburg": {
        "dark": { "hex": "#e0aa4e" },
        "light": { "hex": "#8a6512" }
      },
      "lichdenstein": {
        "dark": { "hex": "#5cbfa2" },
        "light": { "hex": "#1a6b55" }
      },
      "frangfurd": {
        "dark": { "hex": "#7cbfe0" },
        "light": { "hex": "#1c6a8e" }
      }
    },
    "status": {
      "warning": {
        "dark": { "hex": "#e0aa4e" },
        "light": { "hex": "#8a6512" }
      },
      "danger": { "dark": { "hex": "#ef7a5e" }, "light": { "hex": "#b23e21" } }
    },
    "brand": {
      "logo-gradient-top": { "dark": { "hex": "#f9ae9f" }, "light": null },
      "logo-gradient-bottom": { "dark": { "hex": "#6d3939" }, "light": null }
    }
  },
  "type": {
    "family": {
      "ui": [
        "Inter",
        "ui-sans-serif",
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "sans-serif"
      ],
      "display": ["Fraunces", "Iowan Old Style", "Georgia", "serif"],
      "mono": [
        "JetBrains Mono",
        "ui-monospace",
        "SFMono-Regular",
        "Menlo",
        "monospace"
      ]
    },
    "size": {
      "unit": "px",
      "scale": {
        "2xs": 11,
        "xs": 12,
        "sm": 13,
        "base": 14,
        "md": 16,
        "lg": 17,
        "xl": 20,
        "2xl": 26,
        "display": { "size": 76, "lineHeight": 0.95, "tracking": -0.01 }
      }
    },
    "weight": { "body": 400, "medium": 500, "semibold": 600 },
    "tracking": {
      "unit": "em",
      "scale": { "control": 0.01, "label": 0.06, "eyebrow": 0.08 }
    },
    "variation": {
      "display": { "SOFT": 0, "WONK": 0 }
    }
  },
  "radius": {
    "unit": "px",
    "scale": { "sm": 6, "md": 8, "lg": 10, "pill": 999 }
  },
  "motion": {
    "duration": { "unit": "ms", "scale": { "fast": 140, "slow": 420 } },
    "easing": {
      "standard": [0.22, 0.61, 0.36, 1],
      "out": [0.16, 1, 0.3, 1],
      "glide": [0.45, 0, 0.15, 1]
    }
  },
  "layout": {
    "unit": "px",
    "sidebar": 264,
    "hero": 440,
    "titlebar": 40,
    "scrollbar": 6,
    "slide": 32,
    "icon": { "sm": 16, "md": 18, "stroke": 1.2 },
    "window": {
      "width": 1280,
      "height": 800,
      "minWidth": 1024,
      "minHeight": 640
    }
  },
  "effect": {
    "hoverBrightness": 1.08,
    "focusRing": { "width": 2, "offset": 2 },
    "scrim": { "unit": "%", "edge": 96, "mid": 78, "midAt": 42, "far": 18, "wash": 84 },
    "artPending": { "tint": 6, "line": 8, "cell": 48, "cellThumb": 8 },
    "motionBlur": 4
  }
}

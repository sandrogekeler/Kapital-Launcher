{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sandrogekeler/Kapital-Launcher/design/tokens.schema.json",
  "title": "Kapital Launcher design tokens",
  "description": "The one file a design value is defined in. Values are plain data, never CSS: a colour is { hex, alpha? }, an easing is four numbers, a size is a bare number with the unit on its group. frontend/scripts/gen-tokens.mjs turns this into the CSS, TypeScript and Go the app reads.",
  "type": "object",
  "required": ["version", "color", "type", "radius", "motion", "layout", "effect"],
  "additionalProperties": false,
  "$defs": {
    "hex": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
    "colorValue": {
      "type": "object",
      "required": ["hex"],
      "additionalProperties": false,
      "properties": {
        "hex": { "$ref": "#/$defs/hex" },
        "alpha": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        }
      }
    },
    "color": {
      "type": "object",
      "required": ["dark"],
      "additionalProperties": false,
      "properties": {
        "dark": { "$ref": "#/$defs/colorValue" },
        "light": {
          "oneOf": [{ "$ref": "#/$defs/colorValue" }, { "type": "null" }],
          "description": "null inherits the dark value."
        }
      }
    },
    "colorGroup": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/color" }
    },
    "scale": {
      "type": "object",
      "required": ["unit", "scale"],
      "additionalProperties": false,
      "properties": {
        "unit": { "enum": ["px", "ms", "em"] },
        "scale": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "additionalProperties": { "type": "number", "minimum": 0 }
        }
      }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "source": {
      "type": "object",
      "description": "Where these values were taken from. Documentation, read by nothing.",
      "additionalProperties": { "type": "string" }
    },
    "color": {
      "type": "object",
      "required": ["surface", "text", "line", "chapter", "status"],
      "additionalProperties": false,
      "properties": {
        "surface": { "$ref": "#/$defs/colorGroup" },
        "text": { "$ref": "#/$defs/colorGroup" },
        "line": { "$ref": "#/$defs/colorGroup" },
        "chapter": {
          "allOf": [{ "$ref": "#/$defs/colorGroup" }],
          "description": "One accent per chapter, keyed by the chapter id the launcher manifest uses. --accent resolves to whichever is active."
        },
        "status": { "$ref": "#/$defs/colorGroup" },
        "brand": {
          "allOf": [{ "$ref": "#/$defs/colorGroup" }],
          "description": "Colours of the Kapitel Kapital artwork itself, the same in both themes: logo-gradient-top and logo-gradient-bottom are the two ends of the lettering's vertical gradient in the Kapitel Kapital and Kapital Launcher logos, as the author gave them on 2026-09-30."
        }
      }
    },
    "type": {
      "type": "object",
      "required": ["family", "size", "weight"],
      "additionalProperties": false,
      "properties": {
        "family": {
          "type": "object",
          "required": ["ui", "display", "mono"],
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "size": {
          "type": "object",
          "required": ["unit", "scale"],
          "additionalProperties": false,
          "properties": {
            "unit": { "const": "px" },
            "scale": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]*$" },
              "additionalProperties": {
                "oneOf": [
                  { "type": "number", "minimum": 0 },
                  {
                    "type": "object",
                    "required": ["size"],
                    "additionalProperties": false,
                    "properties": {
                      "size": { "type": "number", "minimum": 0 },
                      "lineHeight": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "description": "Unitless ratio."
                      },
                      "tracking": { "type": "number", "description": "In em." }
                    }
                  }
                ]
              }
            }
          }
        },
        "weight": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 100,
            "maximum": 900
          }
        },
        "tracking": { "$ref": "#/$defs/scale", "description": "Letter-spacing by role, in em: control (a button label), label (a small caps line), eyebrow (a wide mono caption)." },
        "variation": {
          "type": "object",
          "description": "font-variation-settings per family, as axis tag to value.",
          "additionalProperties": {
            "type": "object",
            "propertyNames": { "pattern": "^[A-Za-z]{4}$" },
            "additionalProperties": { "type": "number" }
          }
        }
      }
    },
    "radius": { "$ref": "#/$defs/scale" },
    "motion": {
      "type": "object",
      "required": ["duration", "easing"],
      "additionalProperties": false,
      "properties": {
        "duration": { "$ref": "#/$defs/scale" },
        "easing": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "number" }
          }
        }
      }
    },
    "layout": {
      "type": "object",
      "required": ["unit", "sidebar", "hero", "titlebar", "icon", "scrollbar", "slide", "drift", "title", "playMin", "window", "splash"],
      "additionalProperties": false,
      "properties": {
        "unit": { "const": "px" },
        "sidebar": { "type": "integer", "minimum": 1 },
        "hero": {
          "type": "integer",
          "minimum": 1,
          "description": "The hero's greatest height; it shrinks below this so the chapter card fits the window (#68)."
        },
        "titlebar": { "type": "integer", "minimum": 1 },
        "slide": {
          "type": "integer",
          "minimum": 0,
          "description": "How far the chapter card travels on a switch, in px (#59)."
        },
        "drift": {
          "type": "integer",
          "minimum": 0,
          "description": "How far the hero's picture and the wiki post travel when the chapter's slide changes, in px (#142): out to the left, in from the right."
        },
        "title": {
          "type": "integer",
          "minimum": 1,
          "description": "The height of every chapter's title artwork in the hero, in px, so the three read as one size whatever their proportions (#77)."
        },
        "playMin": {
          "type": "integer",
          "minimum": 1,
          "description": "The least width of the play button, in px, measured at the widest label it carries with the real fonts (Install Lichdenstein, 237px), so Play, Join, Install and Stop never change its width and the state line beside it never moves."
        },
        "scrollbar": {
          "type": "integer",
          "minimum": 1,
          "description": "The width of the app's own scroll thumb (components/ui/Scrollable): a pill drawn over the content; the native bar is hidden."
        },
        "icon": {
          "type": "object",
          "description": "Icon box sizes, the px value lucide draws at, and the stroke weight in screen px that lucide's absoluteStrokeWidth holds constant across sizes.",
          "required": ["sm", "md", "stroke"],
          "additionalProperties": false,
          "properties": {
            "sm": { "type": "integer", "minimum": 1 },
            "md": { "type": "integer", "minimum": 1 },
            "stroke": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "window": {
          "type": "object",
          "required": ["width", "height", "minWidth", "minHeight"],
          "additionalProperties": false,
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "minWidth": { "type": "integer", "minimum": 1 },
            "minHeight": { "type": "integer", "minimum": 1 }
          }
        },
        "splash": {
          "type": "object",
          "description": "The loading card the launcher window becomes while a game starts (#43), in logical px. Go sizes the window to it; the view lays the card out to fill it.",
          "required": ["width", "height"],
          "additionalProperties": false,
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "effect": {
      "type": "object",
      "description": "Values a utility cannot name on its own: the hover lift on the filled button, the focus outline, the stops of the scrim over artwork, and the grid shown where a chapter has no artwork yet.",
      "required": ["hoverBrightness", "focusRing", "scrim", "accent", "artPending", "motionBlur", "tileBlur", "tileTint"],
      "additionalProperties": false,
      "properties": {
        "hoverBrightness": { "type": "number", "exclusiveMinimum": 1, "maximum": 2 },
        "focusRing": {
          "type": "object",
          "description": "The keyboard focus outline, width and offset in px.",
          "required": ["width", "offset"],
          "additionalProperties": false,
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "offset": { "type": "integer", "minimum": 0 }
          }
        },
        "scrim": {
          "type": "object",
          "description": "Opacity of the page ground over artwork, in percent: edge at the text side, mid at midAt across, far at the other side; wash is the even cover on narrow screens; tile is the even cover on a selected nav tile's blurred art (#69).",
          "required": ["unit", "edge", "mid", "midAt", "far", "wash", "tile"],
          "additionalProperties": false,
          "properties": {
            "unit": { "const": "%" },
            "edge": { "type": "number", "minimum": 0, "maximum": 100 },
            "mid": { "type": "number", "minimum": 0, "maximum": 100 },
            "midAt": { "type": "number", "minimum": 0, "maximum": 100 },
            "far": { "type": "number", "minimum": 0, "maximum": 100 },
            "wash": { "type": "number", "minimum": 0, "maximum": 100 },
            "tile": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        },
        "accent": {
          "type": "object",
          "description": "How much of the chapter accent goes into its two derived colours, in percent: wash is the tint behind a selected control, edge the border of the nav highlight.",
          "required": ["unit", "wash", "edge"],
          "additionalProperties": false,
          "properties": {
            "unit": { "const": "%" },
            "wash": { "type": "number", "minimum": 0, "maximum": 100 },
            "edge": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        },
        "artPending": {
          "type": "object",
          "description": "The accent grid where a chapter has no artwork: tint and line are percent of the accent, cell and cellThumb the grid pitch in px on the hero and the thumbnail.",
          "required": ["tint", "line", "cell", "cellThumb"],
          "additionalProperties": false,
          "properties": {
            "tint": { "type": "number", "minimum": 0, "maximum": 100 },
            "line": { "type": "number", "minimum": 0, "maximum": 100 },
            "cell": { "type": "integer", "minimum": 1 },
            "cellThumb": { "type": "integer", "minimum": 1 }
          }
        },
        "tileTint": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "How far the art behind a selected nav tile is tinted toward the chapter's accent, in percent (#77)."
        },
        "tileBlur": {
          "type": "number",
          "minimum": 0,
          "description": "The blur in px on the chapter's art behind its selected nav tile (#69)."
        },
        "motionBlur": {
          "type": "number",
          "minimum": 0,
          "description": "The blur in px at the middle of the chapter card's slide (#59). 0 turns the blur off and keeps the slide."
        }
      }
    }
  }
}
